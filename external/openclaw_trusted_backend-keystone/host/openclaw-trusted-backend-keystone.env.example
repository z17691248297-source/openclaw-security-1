KEYSTONE_BACKEND_BIND=0.0.0.0
KEYSTONE_BACKEND_PORT=19090
KEYSTONE_BACKEND_CA_BINARY=./keystone_example_openclaw_trusted_backend
KEYSTONE_TRUSTED_VERIFY_MODE=ed25519
KEYSTONE_TRUSTED_SIGNING_PRIVATE_KEY_FILE=/etc/openclaw-trusted-backend-keystone/ed25519-private.pem
KEYSTONE_TRUSTED_UPSTREAM_TDX_PUBLIC_KEY_FILE=/etc/openclaw-trusted-backend-keystone/tdx-ed25519-public.pem
KEYSTONE_SCOPE_TOKEN_TTL_MS=15000
KEYSTONE_CONFIRMATION_TTL_MS=300000
KEYSTONE_GUEST_ID=keystone-guest:openclaw-keystone-01
KEYSTONE_SERVICE_NAME=openclaw-keystone-trusted-backend
