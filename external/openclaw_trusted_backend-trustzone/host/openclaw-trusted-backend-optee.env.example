OPTEE_BACKEND_BIND=0.0.0.0
OPTEE_BACKEND_PORT=19090
OPTEE_BACKEND_CA_BINARY=/usr/bin/optee_example_openclaw_trusted_backend
OPTEE_TRUSTED_VERIFY_MODE=ed25519
OPTEE_TRUSTED_SIGNING_PRIVATE_KEY_FILE=/etc/openclaw-trusted-backend-optee/ed25519-private.pem
OPTEE_SCOPE_TOKEN_TTL_MS=15000
OPTEE_CONFIRMATION_TTL_MS=300000
